# Record of the promoted solver env (PARTNER_* knobs) for local experiments.
#
# The contest package does NOT read this file: src/shipping/op_wrapper.py sets
# the full promoted env as setdefaults (budget table, FLOW_CKPT / DIRECT_CKPT,
# every PARTNER_* knob below), and scripts/eval_*.sh evaluate that package.
# Gate chains (scripts/gate/run_shadow.sh) pass env pairs explicitly.
# Evidence for each decision: docs/experiments/ (dates in the comments).
#
# 0729: PARTNER_BUDGET_MAX=3.5 PARTNER_DIRECT_MIN=2.0 PARTNER_DIRECT_SOLVER=dpmpp
#       PARTNER_DDIM_STEPS=10 PARTNER_REFINE_STALL_STOP=1 (+ flow st8 euler
#       antithetic, NREF=15, OVERSAMPLE=4, TAG_ANCHOR_EXTRA=3, VKILL_OFF=1,
#       PRESCREEN_V=1)
# 0805 (exp 11, 3 sign-consistent paired reps, dNoRT mean -0.0107, runtime -5%):
PARTNER_REFINE_KERNEL=numba
PARTNER_REFINE_FASTBUILD=1
# 0805 (exp 16): budget-aware anneal-span floor + bit-exact numpy seed twin.
PARTNER_FAST_SETUP=1
# 0806 (frontier-bracket gate, docs/experiments/2026-08-06-frontier-bracket-promotion-gate.md):
#       shipped operating point = 0.3 s tier: SCALE=8.498e-5 TAU=12 MIN=0.05
#       MAX=1.22 POOL_GATE=0 SA_KERNEL=numba NREF=6 DIRECT_MIN=0.3 DDIM_STEPS=2,
#       plus PARTNER_EDGE_SEAT_V2=1, PARTNER_FRAME_WPIN=1.
#       PARTNER_COORD_POLISH deliberately OFF in the shipped package (raw -0.014
#       but +0.25 s post-deadline on every n>=95 case; runtime-aware total worse).
# 0811: PARTNER_FRAME_SCALE_LADDER=1 PARTNER_FRAME_SCALE_SET=1.02 (5/5 paired
#       reps, mean -0.0168); PARTNER_SEAT_FINAL=1 (final seat pass after polish);
PARTNER_TAG_COMPRESS=1
# 0826-0831 (final sprint, docs/experiments/2026-08-21-post-beta-p0-execution.md
#       §17-18): mid budget table (src/shipping/budget_table_mid.txt),
#       PARTNER_REFINE_RES_FRAC=0.45 PARTNER_WALL_REPAIR=1 PARTNER_FLOW_WARM=1
#       PARTNER_EARLY_EXIT=1 PARTNER_REFINE_SECURE_FALLBACK=1 PARTNER_GROUP_BRIDGE=1
#       PARTNER_FLOW_SLOTS=16 PARTNER_NREF=12 PARTNER_FINAL_LEGAL_GUARD=1,
#       FLOW_CKPT = tail-tilted fine-tune (B': ft0829 T=12 250k EMA;
#       C': FT2xFT3 soup a50), DIRECT_CKPT = direct_v2_student_s2.pt.
