# FloorSet solver environment defaults.
# Source this file before local runs, or use scripts/eval_single.sh and
# scripts/eval_total.sh, which source it automatically when present.

# --- Partner-path promoted env (record of decision; enforced in the
# --- submission package via cadc1013/op_wrapper.py setdefaults, and set
# --- explicitly by the partner eval chains -- the FLOORSET_* scripts below
# --- do not consume these).
# 0729 定案: PARTNER_BUDGET_MAX=3.5 PARTNER_DIRECT_MIN=2.0
#            PARTNER_DIRECT_SOLVER=dpmpp PARTNER_DDIM_STEPS=10
#            PARTNER_REFINE_STALL_STOP=1 (+ flow st8 euler antithetic,
#            NREF=15, OVERSAMPLE=4, TAG_ANCHOR_EXTRA=3, VKILL_OFF=1,
#            PRESCREEN_V=1)
# 0805 定案 (exp 11, three sign-consistent paired reps at MAX=3.5:
#            dNoRT -0.0109/-0.0091/-0.0121 mean -0.0107, runtime ~-5%):
PARTNER_REFINE_KERNEL=numba
PARTNER_REFINE_FASTBUILD=1
# 0805 定案 (exp 16): budget-aware anneal-span floor + bit-exact numpy seed
# twin (PARTNER_FAST_SETUP). Goal tier: flag alone -0.0089/-0.0054 with avg
# 0.22->0.155s; re-spend arms -0.0260/-0.0237 @ 0.206s; exact-0.200s point
# = SCALE 7.0e-5 MAX 0.9 -> noRT 1.196. At MAX=3.5 the span clamp is
# inactive by construction and the seed twin is bit-exact -> cross-tier.
PARTNER_FAST_SETUP=1

# Production path (promoted 2026-07-05 on Evaluator Evidence): column-slicing
# backbone + slack refiner. Full-validation total_score_no_runtime 1.238-1.246
# across repeated runs vs 2.1158 for the previous GNN-guided path, 100/100
# feasible in every run (feasibility by construction + pure-function refiner).
FLOORSET_COLUMN_BACKBONE=1
FLOORSET_SLACK_REFINE=1
FLOORSET_SLACK_REFINE_ASPECT=1
FLOORSET_SLACK_REFINE_VSNAP=1
# Memoized per-column SA layout (promoted 2026-07-05): semantically identical
# per move (shadow-checked to 5e-13), buys ~1.05-1.5x more moves in the same
# wall clock. Paired full runs: 1.2337 vs 1.2438, n>=100 mean delta -0.0097.
FLOORSET_FAST_EVAL=1
# Windowed LNS re-pack (promoted 2026-07-05): tension-ranked windows repacked
# with exact-area aspect flex, guard-gated (accepts strict improvements only,
# never regresses a layout). Two full runs: 1.2298 / 1.2309 vs 1.2337 base;
# true effect ~ -0.003. Reserve slimmed to min(1.0, 0.10*remaining) on n>=60.
FLOORSET_WINDOW_REPACK=1

# W1 restart-portfolio widening (promoted 2026-07-08): raise the SA worker
# pool past the historical min(12, cores//2) cap and extend the 12-entry
# config list with a diversified grid. Hidden-test machine has 48 cores
# (official QA A3); widening is a zero-wall-clock order-statistics lever.
# Paired evidence (4-control pool): W1 alone -0.0064 at unchanged runtime.
FLOORSET_SA_WORKERS=32
FLOORSET_SA_CONFIGS=32

# E2 tail time budget (promoted 2026-07-08 per user decision): double the SA
# budget on n>=100 (the band holding 77% of remaining weighted prize).
# Paired evidence: -0.0128 / -0.0091 across two runs; W1xE2 combo -0.0177
# (21/21 wins on n>=100), full total 1.2133, max runtime 47.7s (< the 60s
# signal line). OFFICIAL-SCORE RISK: RuntimeFactor is per-case vs field
# median with uncapped slowness penalty (2x slower = +23%/case) -- the final
# submission config must revisit this trade (see CONTEXT.md RuntimeFactor).
FLOORSET_TAIL_BUDGET_SCALE=2.0
FLOORSET_TAIL_BUDGET_N=100

# Default guidance checkpoint (legacy v5 path, used when the column backbone
# is disabled). Promote only after full validation improves
# total_score_no_runtime; supervised val loss alone is a training health metric.
FLOORSET_GNN_CHECKPOINT=checkpoints/gnn_transformer_best_0521_ns1000000_ep3_encgraph_transformer_h256_l6_acc32_heads8.pt

# Relative-order profile policy: adaptive, soft, compact, or both.
FLOORSET_PROFILE_POLICY=adaptive
FLOORSET_INCLUDE_COMPACT_RELATIVE=1

# Opt-in candidate families. Defaults intentionally keep beam/no-guidance out of
# the production path because current ablations showed runtime regression.
FLOORSET_ENABLE_LARGE_CASE_CANDIDATES=0
FLOORSET_INCLUDE_BEAM_CANDIDATES=0
FLOORSET_INCLUDE_NO_GUIDANCE_CANDIDATE=0
FLOORSET_BEAM_WIDTH=1
FLOORSET_LARGE_CASE_REPAIR_PROFILES=normal
FLOORSET_CANDIDATE_WORKERS=1

# Opt-in diagnostics.
FLOORSET_REPAIR_TRACE_JSONL=

# Repair search caps.
FLOORSET_OVERLAP_REPAIR_CANDIDATES=24
FLOORSET_ENABLE_LARGE_CASE_BOUNDARY_PASS=0
FLOORSET_ENABLE_LARGE_CASE_BOUNDARY_REFINE=0
# These are override-when-present knobs. Leave commented to preserve the
# code's adaptive defaults. Cross-axis boundary search defaults to 160 in code
# for large edge-constrained repairs.
# FLOORSET_BOUNDARY_AXIS_CAP=24
# FLOORSET_BOUNDARY_CROSS_AXIS_CAP=160
# FLOORSET_LARGE_CASE_BOUNDARY_AXIS_CAP=160

# Opt-in relative-order experiment. Default off; current notes say it worsened
# ID 99 in the active decoder path.
FLOORSET_PREPLACED_FRAME_CLAMP=0
